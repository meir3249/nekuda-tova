{
  "name": "nekuda-tova",
  "version": "0.0.0",
  "private": true,
  "description": "One small positive thought a day. A PWA with Web Push.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:boundary": "vitest run tests/boundary",
    "validate:content": "node scripts/validate-content.ts",
    "build:pwa": "node scripts/build-pwa-stub.ts",
    "sender": "node src/sender/main.ts",
    "vapid:generate": "node scripts/generate-vapid-keys.ts",
    "ci": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "web-push": "4.0.0"
  }
}
